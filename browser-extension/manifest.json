{
  "manifest_version": 3,
  "name": "Codex Usage Tray - ChatGPT 알림 연결",
  "version": "1.1.1",
  "description": "ChatGPT 웹 작업 완료와 승인 요청을 Codex Usage Tray로 전달합니다.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "completion-state.js",
        "runtime-messaging.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
